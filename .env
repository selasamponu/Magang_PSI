# ================================================================
# KONFIGURASI APLIKASI SURAT - KEMANTREN TEGALREJO
# ================================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (XAMPP)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=surat_kemantren
DB_PORT=3306

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ✅ CORS whitelist — tambahkan domain ngrok Anda di sini
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://untoasted-absentee-exporter.ngrok-free.dev

# ✅ Domain ngrok permanen Anda (tanpa https://)
VITE_NGROK_URL=untoasted-absentee-exporter.ngrok-free.dev