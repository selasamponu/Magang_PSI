# ================================================================
# KONFIGURASI APLIKASI SURAT - KEMANTREN TEGALREJO
# ================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=rahasia_surat_kemantren_tegalrejo_2024_yang_sangat_rahasia
JWT_EXPIRES_IN=6h

# MySQL Database Configuration (XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=surat_kemantren
DB_PORT=3306

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# CORS Configuration (untuk development)
CORS_ORIGIN=http://localhost:3000

# ================================================================
# CATATAN:
# 1. Copy file ini ke .env (hapus .example)
# 2. Sesuaikan DB_PASSWORD dengan password MySQL Anda
# 3. Pastikan database surat_kemantren sudah dibuat di phpMyAdmin
# 4. Jalankan schema.sql untuk membuat tabel
# 5. Untuk production, ganti JWT_SECRET dengan string yang lebih aman
# ================================================================
